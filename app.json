{
  "expo": {
    "name": "Pipkin",
    "slug": "pipkin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "pipkin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF6EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pipkin.companion",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-icon-foreground.png",
        "backgroundColor": "#FFF6EC"
      },
      "package": "app.pipkin.companion",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-notifications",
        { "color": "#F4A261" }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
